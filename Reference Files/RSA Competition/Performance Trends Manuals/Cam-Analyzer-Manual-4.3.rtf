0\expndtw0 These 5 keys let\expnd0\expndtw-1  \expnd0\expndtw0 you do everything you need to do that the mouse can do in this screen.\expnd8\expndtw40  \expnd0\expndtw0 On laptops without a number keypad, the 0 key or Insert key will work as the 0 key on the number keypad.\par\pard\plain\s1\nooverflow\nocwrap\lnbrkrule\sl240\slmult1\sb1\f0\fs20\b0\i0\par\pard\plain\s1\nooverflow\nocwrap\lnbrkrule\li806\sl240\slmult1\f0\fs20\b0\expnd0\expndtw0\charscalex100 The\expnd0\expndtw-1  \expnd0\expndtw0 general\expnd0\expndtw-2  \expnd0\expndtw0 EZ Data\expnd0\expndtw-1  \expnd0\expndtw0 Entry\expnd0\expndtw-2  \expnd0\expndtw0 procedure would\expnd0\expndtw-1  \expnd0\expndtw0 consist\expnd0\expndtw-1  \expnd-1\expndtw-5 of:\par\pard\plain\s11\ls15\ilvl0\nooverflow\nocwrap\lnbrkrule\li1166\fi-360\sl240\slmult1\sb4\tx1166\f0\fs20\b0\expnd0\expndtw0\charscalex100 Pressing\expnd0\expndtw-1  \expnd0\expndtw0 the\expnd0\expndtw-2  \expnd0\expndtw0 Insert\expnd0\expndtw-2  \expnd0\expndtw0 Key\expnd0\expndtw-2  \expnd0\expndtw0 to\expnd0\expndtw-1  \expnd0\expndtw0 estimate\expnd0\expndtw-2  \expnd0\expndtw0 the\expnd0\expndtw-1  \expnd0\expndtw0 lift\expnd0\expndtw-2  \expnd0\expndtw0 for\expnd-1\expndtw-3  \expnd0\expndtw0 the\expnd0\expndtw-2  \expnd0\expndtw0 current\expnd-1\expndtw-3  \expnd0\expndtw0 row\expnd0\expndtw-1  \expnd0\expndtw0 based\expnd0\expndtw-2  \expnd0\expndtw0 on\expnd0\expndtw-2  \expnd0\expndtw0 the\expnd0\expndtw-2  \expnd0\expndtw0 2\expnd0\expndtw-2  \expnd0\expndtw0 previous\expnd0\expndtw-1  \expnd-1\expndtw-4 rows\par\pard\plain\s11\ls15\ilvl0\nooverflow\nocwrap\lnbrkrule\li1166\fi-360\sl240\slmult1\sb4\tx1166\f0\fs20\b0\expnd0\expndtw0\charscalex100 Pressing\expnd0\expndtw-2  \expnd0\expndtw0 the\expnd0\expndtw-1  \expnd0\expndtw0 left\expnd0\expndtw-2  \expnd0\expndtw0 or\expnd0\expndtw-1  \expnd0\expndtw0 right\expnd0\expndtw-1  \expnd0\expndtw0 arrow\expnd0\expndtw-2  \expnd0\expndtw0 keys\expnd0\expndtw-1  \expnd0\expndtw0 to\expnd0\expndtw-2